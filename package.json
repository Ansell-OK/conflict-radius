{
  "name": "conflict-radar-mcp",
  "version": "0.1.0",
  "description": "Graph-aware semantic conflict detection for parallel coding agents",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ansell-OK/conflict-radius.git"
  },
  "homepage": "https://conflict-radius.vercel.app/",
  "bin": {
    "conflict-radar": "dist/src/cli.js",
    "conflict-radar-mcp": "dist/src/index.js",
    "conflict-radar-ci": "dist/src/ci.js",
    "conflict-radar-admission": "dist/src/admissionServer.js"
  },
  "files": [
    "dist/src",
    "dist/extractor",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copyAssets.mjs",
    "extract": "tsx extractor/extractSymbols.ts",
    "extract:contracts": "tsx extractor/ingestContracts.ts",
    "start": "node dist/src/index.js",
    "start:admission": "node dist/src/admissionServer.js",
    "verify:conflicts": "node dist/scripts/verifyConflicts.js",
    "verify:cross-repo": "node dist/scripts/verifyCrossRepo.js",
    "verify:admission": "node dist/scripts/verifyAdmission.js",
    "verify:admission-http": "node dist/scripts/verifyAdmissionHttp.js",
    "stress:os-automations": "node dist/scripts/stressOperatingSystemAutomations.js",
    "verify:mcp": "node dist/scripts/verifyMcp.js",
    "verify:typescript": "node dist/scripts/verifyTypescript.js",
    "verify:verification": "node dist/scripts/verifyVerification.js",
    "stress:cross-repo": "node dist/scripts/stressCrossRepo.js",
    "conflict-radar-ci": "node dist/src/ci.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "npm run typecheck && npm run build",
    "prepack": "npm run verify:package",
    "prepublishOnly": "npm run verify:package"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "neo4j-driver": "^5.28.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
