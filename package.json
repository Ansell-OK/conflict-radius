{
  "name": "conflict-radar-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "extract": "tsx extractor/extractSymbols.ts",
    "start": "node dist/src/index.js",
    "verify:conflicts": "node dist/scripts/verifyConflicts.js",
    "verify:mcp": "node dist/scripts/verifyMcp.js",
    "verify:verification": "node dist/scripts/verifyVerification.js",
    "conflict-radar-ci": "node dist/src/ci.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "neo4j-driver": "^5.28.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
