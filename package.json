{
  "name": "conflict-radar-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "extract": "tsx extractor/extractSymbols.ts",
    "extract:contracts": "tsx extractor/ingestContracts.ts",
    "start": "node dist/src/index.js",
    "start:admission": "node dist/src/admissionServer.js",
    "verify:conflicts": "node dist/scripts/verifyConflicts.js",
    "verify:cross-repo": "node dist/scripts/verifyCrossRepo.js",
    "verify:admission": "node dist/scripts/verifyAdmission.js",
    "verify:admission-http": "node dist/scripts/verifyAdmissionHttp.js",
    "stress:os-automations": "node dist/scripts/stressOperatingSystemAutomations.js",
    "verify:mcp": "node dist/scripts/verifyMcp.js",
    "verify:typescript": "node dist/scripts/verifyTypescript.js",
    "verify:verification": "node dist/scripts/verifyVerification.js",
    "stress:cross-repo": "node dist/scripts/stressCrossRepo.js",
    "conflict-radar-ci": "node dist/src/ci.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "neo4j-driver": "^5.28.2",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.23.1",
    "tree-sitter-typescript": "^0.23.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
